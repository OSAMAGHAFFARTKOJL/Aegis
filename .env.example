# ---------------------------------------------------------------------------
# Aegis — secure AI knowledge assistant. Copy to `.env.local` and fill in.
# ---------------------------------------------------------------------------

# REQUIRED — signs auth (JWT) sessions.  openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# SQLite database file (created automatically).
DATABASE_PATH=./data/aegis.db

# --- Groq: LLM answers + the Prompt Guard security model ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_RAG_MODEL=openai/gpt-oss-20b

# --- Google Gemini: document + query embeddings ---
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-2

# --- OAuth sign-in (optional). Buttons appear only when both values are set. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
